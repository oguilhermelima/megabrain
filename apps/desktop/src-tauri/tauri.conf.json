{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "megabrain",
  "version": "0.2.4",
  "identifier": "com.oguilhermelima.megabrain",
  "build": {
    "beforeDevCommand": "bun run stage-cli && bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run stage-cli && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "megabrain",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 580,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      },
      {
        "label": "pill",
        "title": "megabrain pill",
        "width": 380,
        "height": 38,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://github.com https://avatars.githubusercontent.com"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/megabrain-cli"
    ],
    "resources": {
      "binaries/share/megabrain/": "megabrain/"
    }
  }
}
