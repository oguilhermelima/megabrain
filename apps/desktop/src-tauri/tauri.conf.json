{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "megabrain",
  "version": "0.2.4",
  "identifier": "com.oguilhermelima.megabrain",
  "build": {
    "beforeDevCommand": "bun run stage-cli && bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run stage-cli && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "megabrain",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 580,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        },
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      },
      {
        "label": "pill",
        "title": "megabrain pill",
        "width": 380,
        "height": 38,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "x": 0,
        "y": 0
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://github.com https://avatars.githubusercontent.com; frame-src http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**/*.png",
            "$HOME/**/*.jpg",
            "$HOME/**/*.jpeg",
            "$HOME/**/*.gif",
            "$HOME/**/*.webp",
            "$HOME/**/*.PNG",
            "$HOME/**/*.JPG",
            "$HOME/**/*.JPEG",
            "$HOME/**/*.GIF",
            "$HOME/**/*.WEBP",
            "$HOME/.megabrain/project-pictures/*.png",
            "$HOME/.megabrain/project-pictures/*.jpg",
            "$HOME/.megabrain/project-pictures/*.jpeg",
            "$HOME/.megabrain/project-pictures/*.webp",
            "$HOME/.megabrain/project-pictures/*.svg",
            "$HOME/.megabrain/maestro/**/*.png",
            "$HOME/.megabrain/native/screens/*.png",
            "$HOME/.megabrain/attachments/*.png",
            "$HOME/.megabrain/attachments/*.jpg",
            "$HOME/.megabrain/attachments/*.jpeg",
            "$HOME/.megabrain/attachments/*.gif",
            "$HOME/.megabrain/attachments/*.webp",
            "$HOME/.megabrain/attachments/*.PNG",
            "$HOME/.megabrain/attachments/*.JPG",
            "$HOME/.megabrain/attachments/*.JPEG",
            "$HOME/.megabrain/attachments/*.GIF",
            "$HOME/.megabrain/attachments/*.WEBP",
            "/var/folders/**/*.png",
            "/var/folders/**/*.jpg",
            "/var/folders/**/*.jpeg",
            "/var/folders/**/*.gif",
            "/var/folders/**/*.webp",
            "/var/folders/**/*.PNG",
            "/var/folders/**/*.JPG",
            "/var/folders/**/*.JPEG",
            "/var/folders/**/*.GIF",
            "/var/folders/**/*.WEBP",
            "/private/var/folders/**/*.png",
            "/private/var/folders/**/*.jpg",
            "/private/var/folders/**/*.jpeg",
            "/private/var/folders/**/*.gif",
            "/private/var/folders/**/*.webp",
            "/private/var/folders/**/*.PNG",
            "/private/var/folders/**/*.JPG",
            "/private/var/folders/**/*.JPEG",
            "/private/var/folders/**/*.GIF",
            "/private/var/folders/**/*.WEBP",
            "/tmp/**/*.png",
            "/tmp/**/*.jpg",
            "/tmp/**/*.jpeg",
            "/tmp/**/*.gif",
            "/tmp/**/*.webp",
            "/tmp/**/*.PNG",
            "/tmp/**/*.JPG",
            "/tmp/**/*.JPEG",
            "/tmp/**/*.GIF",
            "/tmp/**/*.WEBP",
            "/private/tmp/**/*.png",
            "/private/tmp/**/*.jpg",
            "/private/tmp/**/*.jpeg",
            "/private/tmp/**/*.gif",
            "/private/tmp/**/*.webp",
            "/private/tmp/**/*.PNG",
            "/private/tmp/**/*.JPG",
            "/private/tmp/**/*.JPEG",
            "/private/tmp/**/*.GIF",
            "/private/tmp/**/*.WEBP"
          ]
        }
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/megabrain-cli"
    ],
    "resources": {
      "binaries/share/megabrain/": "megabrain/"
    }
  }
}
